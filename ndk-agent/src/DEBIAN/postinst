#!/bin/bash
set -e

PYBASE="/opt/srlinux/python/virtual-env/lib"

# Detectar versión de Python disponible
if [ -d "${PYBASE}/python3.13" ]; then
    PYVER="python3.13"
elif [ -d "${PYBASE}/python3.11" ]; then
    PYVER="python3.11"
else
    # Fallback: buscar dinámicamente
    PYVER=$(ls "${PYBASE}" 2>/dev/null | grep "^python3\." | sort -V | tail -1 || true)
fi

SITE_PACKAGES="${PYBASE}/${PYVER}/dist-packages"

echo "Installing netns to ${SITE_PACKAGES}"
mkdir -p "${SITE_PACKAGES}"
cp /tmp/netns_install/netns.py "${SITE_PACKAGES}/netns.py"
cp -r /tmp/netns_install/netns-1.0-py3.6.egg-info/ "${SITE_PACKAGES}/netns-1.0-py3.6.egg-info/"

export PYTHONPATH="$PYTHONPATH:/etc/opt/srlinux/helper:/etc/opt/srlinux/appmgr/multicli:/opt/srlinux/bin:/usr/lib/${PYVER}/dist-packages/sdk_protos:/usr/lib/${PYVER}/dist-packages"

# Limpiar temp
rm -rf /tmp/netns_install